# ============================================================
#  .gitignore per plugin Autodesk (AutoCAD / Civil 3D / Revit)
#  Linguaggi: C#, Python, PowerShell
# ============================================================

# -------------------- C# / .NET / Visual Studio --------------------
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.dll
*.pdb
*.cache

# Pacchetti NuGet ripristinati automaticamente
packages/
*.nupkg
[Pp]ackages/

# Build output vari
[Dd]ebug/
[Rr]elease/
[Xx]64/
[Xx]86/
[Bb]uild/
build/
publish/
*.exe

# Risultati dei test
[Tt]est[Rr]esult*/
*.trx

# -------------------- Python --------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# -------------------- PowerShell --------------------
*.ps1xml.bak

# -------------------- Segreti / configurazioni locali --------------------
# NON committare mai credenziali o config personali
.env
*.env
secrets.json
appsettings.local.json
*.pfx
*.snk

# -------------------- Sistema operativo / editor --------------------
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~
.idea/
*.log
*.tmp

# -------------------- File Autodesk temporanei/backup --------------------
*.bak
*.dwl
*.dwl2
*.sv$
*.err
