<UserControl x:Class="MN_LayoutManager.UI.LayoutPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MN_LayoutManager.UI"
             MinWidth="240" MinHeight="260"
             Background="{DynamicResource PanelBrush}"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MN_LayoutManager;component/Themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <ui:BoolToVisibilityConverter x:Key="BoolToVisibilityInverse" Invert="True" />

            <!-- Righe dell'elenco: la selezione della lista e' collegata alla proprieta'
                 IsSelected di ogni riga, cosi' il "cervello" sa sempre cosa e' selezionato. -->
            <Style x:Key="BoundLayoutListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource LayoutListItemStyle}">
                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            </Style>

            <DataTemplate x:Key="LayoutRowTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Puntino che segnala il layout attualmente aperto nel disegno. -->
                    <Ellipse Grid.Column="0"
                             Width="6" Height="6"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{StaticResource AccentBrush}"
                             Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Column="1"
                               Style="{StaticResource BodyTextStyle}"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityInverse}}" />

                    <TextBox Grid.Column="1"
                             x:Name="EditBox"
                             Style="{StaticResource InlineEditTextBoxStyle}"
                             Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                             IsVisibleChanged="OnEditBoxVisibleChanged"
                             KeyDown="OnEditBoxKeyDown"
                             LostKeyboardFocus="OnEditBoxLostFocus" />
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ Intestazione: disegno attivo ============ -->
        <TextBlock Grid.Row="0"
                   Style="{StaticResource SecondaryTextStyle}"
                   Text="{Binding DocumentName}"
                   Margin="2,0,2,8" />

        <!-- ============ Barra degli strumenti ============ -->
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,8">
            <Button Style="{StaticResource AccentButtonStyle}"
                    Content="Nuovo layout"
                    Margin="0,0,4,4"
                    Command="{Binding NewLayoutCommand}" />
            <Button Style="{StaticResource ToolButtonStyle}"
                    Content="Seleziona tutti"
                    Margin="4,0,0,4"
                    Command="{Binding SelectAllCommand}" />
            <Button Style="{StaticResource ToolButtonStyle}"
                    Content="Stampa tutti"
                    Margin="0,4,4,0"
                    Command="{Binding PrintAllCommand}" />
            <Button Style="{StaticResource ToolButtonStyle}"
                    Content="Pubblica tutti"
                    Margin="4,4,0,0"
                    Command="{Binding PublishAllCommand}" />
        </UniformGrid>

        <!-- ============ Elenco dei layout ============ -->
        <Grid Grid.Row="2">
            <ListBox x:Name="LayoutList"
                     Style="{StaticResource LayoutListBoxStyle}"
                     ItemsSource="{Binding Layouts}"
                     ItemContainerStyle="{StaticResource BoundLayoutListItemStyle}"
                     ItemTemplate="{StaticResource LayoutRowTemplate}"
                     AllowDrop="True"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnListDoubleClick"
                     PreviewMouseLeftButtonDown="OnListPreviewMouseLeftButtonDown"
                     PreviewMouseMove="OnListPreviewMouseMove"
                     DragOver="OnListDragOver"
                     DragLeave="OnListDragLeave"
                     Drop="OnListDrop">

                <ListBox.InputBindings>
                    <KeyBinding Key="F2" Command="{Binding BeginRenameCommand}" />
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                    <KeyBinding Key="Enter" Command="{Binding ActivateCommand}" />
                    <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyCommand}" />
                    <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
                    <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}" />
                </ListBox.InputBindings>

                <ListBox.ContextMenu>
                    <ContextMenu Style="{StaticResource DarkContextMenuStyle}"
                                 DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                                  Header="Attiva" InputGestureText="Doppio clic"
                                  Command="{Binding ActivateCommand}" />
                        <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                                  Header="Rinomina" InputGestureText="F2"
                                  Command="{Binding BeginRenameCommand}" />
                        <Separator Style="{StaticResource DarkSeparatorStyle}" />
                        <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                                  Header="Copia" InputGestureText="Ctrl+C"
                                  Command="{Binding CopyCommand}" />
                        <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                                  Header="Incolla" InputGestureText="Ctrl+V"
                                  Command="{Binding PasteCommand}" />
                        <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                                  Header="Elimina" InputGestureText="Canc"
                                  Command="{Binding DeleteCommand}" />
                        <Separator Style="{StaticResource DarkSeparatorStyle}" />
                        <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                                  Header="Impostazioni di pagina..."
                                  Command="{Binding PageSetupCommand}" />
                        <Separator Style="{StaticResource DarkSeparatorStyle}" />
                        <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                                  Header="Stampa selezionati"
                                  Command="{Binding PrintSelectedCommand}" />
                        <MenuItem Style="{StaticResource DarkMenuItemStyle}"
                                  Header="Pubblica selezionati..."
                                  Command="{Binding PublishSelectedCommand}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- Barra che mostra dove finira' il layout trascinato. -->
            <Canvas x:Name="DropLayer" IsHitTestVisible="False">
                <Border x:Name="DropIndicator"
                        Height="2"
                        Background="{StaticResource AccentBrush}"
                        Visibility="Collapsed" />
            </Canvas>
        </Grid>

        <!-- ============ Destinazione di stampa e pubblicazione ============ -->
        <Expander Grid.Row="3"
                  Style="{StaticResource SectionExpanderStyle}"
                  Header="STAMPA E PUBBLICAZIONE"
                  IsExpanded="False"
                  Margin="0,8,0,0">
            <StackPanel>

                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Text="Viene creato un file separato per ogni layout, con il nome del layout."
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Cartella:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               MinWidth="58" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding OutputFolder}" />
                    <Button Grid.Column="2"
                            Style="{StaticResource ToolButtonStyle}"
                            Content="Sfoglia..."
                            Margin="6,0,0,0"
                            Command="{Binding BrowseOutputFolderCommand}" />
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource BodyTextStyle}"
                               Text="Formato:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               MinWidth="58" />
                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                 Content="PDF"
                                 GroupName="PublishFormat"
                                 IsChecked="{Binding IsPdfFormat, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                 Content="DWF"
                                 GroupName="PublishFormat"
                                 IsChecked="{Binding IsDwfFormat, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                 Content="DWFx"
                                 GroupName="PublishFormat"
                                 IsChecked="{Binding IsDwfxFormat, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- ============ Rinomina multipla ============ -->
        <Expander Grid.Row="4"
                  Style="{StaticResource SectionExpanderStyle}"
                  Header="RINOMINA MULTIPLA"
                  IsExpanded="False"
                  Margin="0,8,0,0">
            <StackPanel>

                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding BatchModeHint}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Contiene:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding BatchFilter, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!-- WrapPanel: se la palette e' stretta i pulsanti vanno a capo da soli
                     invece di uscire dal bordo. -->
                <WrapPanel Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                 Content="Aggiungi prefisso"
                                 Margin="0,0,12,6"
                                 GroupName="BatchMode"
                                 IsChecked="{Binding IsPrefixMode, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                 Content="Aggiungi suffisso"
                                 Margin="0,0,12,6"
                                 GroupName="BatchMode"
                                 IsChecked="{Binding IsSuffixMode, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                 Content="Togli prefisso"
                                 Margin="0,0,12,6"
                                 GroupName="BatchMode"
                                 IsChecked="{Binding IsRemovePrefixMode, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                 Content="Togli suffisso"
                                 Margin="0,0,12,6"
                                 GroupName="BatchMode"
                                 IsChecked="{Binding IsRemoveSuffixMode, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource OptionRadioStyle}"
                                 Content="Trova/Sostituisci"
                                 Margin="0,0,12,6"
                                 GroupName="BatchMode"
                                 IsChecked="{Binding IsFindReplaceMode, Mode=TwoWay}" />
                </WrapPanel>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="{Binding BatchValueLabel}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               MinWidth="58" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding BatchValue, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Grid Margin="0,0,0,8"
                      Visibility="{Binding IsFindReplaceMode, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource BodyTextStyle}"
                               Text="Sostituisci:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               MinWidth="58" />
                    <TextBox Grid.Column="1"
                             Style="{StaticResource InputTextBoxStyle}"
                             Text="{Binding BatchReplacement, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Button Style="{StaticResource AccentButtonStyle}"
                        Content="Applica"
                        HorizontalAlignment="Right"
                        MinWidth="90"
                        Command="{Binding ApplyBatchRenameCommand}" />
            </StackPanel>
        </Expander>

        <!-- ============ Riga di stato ============ -->
        <TextBlock Grid.Row="5"
                   Style="{StaticResource SecondaryTextStyle}"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Margin="2,8,2,0" />
    </Grid>
</UserControl>
