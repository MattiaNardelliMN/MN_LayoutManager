<Project Sdk="Microsoft.NET.Sdk">

  <!-- Il plugin vero e proprio: comandi AutoCAD + palette WPF.
       ATTENZIONE: il target .NET deve corrispondere ad AutoCAD 2024 -> .NET Framework 4.8.
       Cambiare questo valore fa fallire il caricamento del plugin. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <RootNamespace>MN_LayoutManager</RootNamespace>
    <AssemblyName>MN_LayoutManager</AssemblyName>
  </PropertyGroup>

  <!-- Percorso di installazione di AutoCAD 2024. Se AutoCAD e' installato
       altrove, e' l'unica riga da cambiare in tutto il progetto. -->
  <PropertyGroup>
    <AutoCadInstallDir Condition="'$(AutoCadInstallDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2024\</AutoCadInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MN_LayoutManager.Core\MN_LayoutManager.Core.csproj" />
  </ItemGroup>

  <!-- Le DLL di AutoCAD sono gia' caricate dal software: Private=false evita
       di copiarle nella cartella di output (copiarle causa conflitti a runtime). -->
  <ItemGroup>
    <Reference Include="acmgd">
      <HintPath>$(AutoCadInstallDir)acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCadInstallDir)acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="accoremgd">
      <HintPath>$(AutoCadInstallDir)accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(AutoCadInstallDir)AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="VerificaAutoCadPresente" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(AutoCadInstallDir)acmgd.dll')"
           Text="Non trovo le DLL di AutoCAD in '$(AutoCadInstallDir)'. Correggi la proprieta' AutoCadInstallDir in MN_LayoutManager.csproj." />
  </Target>

</Project>
