<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logica "pura" del plugin: nessun riferimento ad AutoCAD, nessuna UI.
       Vive da sola e per questo si puo' testare in automatico. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MN_LayoutManager.Core</RootNamespace>
    <AssemblyName>MN_LayoutManager.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
